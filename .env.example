# hanyo-api
API_PORT=3101
# Password to log into the app (single user)
HANYO_PASSWORD=change-me
# Secret used to sign session cookies (openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string
# Where SQLite + image cache live
DATA_DIR=./data
# Re-encode pages to WebP (mozjpeg for very tall strips) at this quality. 90 = visually lossless,
# ~80% smaller downloads. 0 keeps the originals.
IMAGE_QUALITY=90
# Max disk used by the page/cover image cache, in MB
IMAGE_CACHE_MAX_MB=8000

# Suwayomi (local only, never exposed)
SUWAYOMI_URL=http://127.0.0.1:4567
# Comma-separated Suwayomi source ids to search. Empty = every installed source in SUWAYOMI_LANGS.
SUWAYOMI_SOURCES=
# Source languages to use (Suwayomi codes; "es" also covers "es-419").
SUWAYOMI_LANGS=en,es

# Library update checks (minutes, 0 disables)
UPDATE_INTERVAL_MIN=180

# Web push (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
